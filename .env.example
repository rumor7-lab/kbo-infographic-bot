# 로컬 개발용. 실제 값은 절대 커밋하지 않는다.
# GitHub Actions 에서는 리포지토리 Settings → Secrets and variables → Actions 에 등록.

# ── Instagram (필수) ──
# 인증 방식: Instagram API with Instagram Login (FB 페이지 연결 불필요).
# IG_USER_ID: Meta 개발자 콘솔 → 앱 → 앱 설정 → Instagram →
#   "Instagram 로그인이 포함된 API 설정" 페이지에 연결된 계정과 ID가 바로 보임.
#   같은 페이지의 "토큰 생성" 버튼으로 IG_ACCESS_TOKEN 도 바로 발급 가능.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# ── 토큰 자동 갱신용 (권장) ──
# IG_APP_SECRET: 같은 Instagram API 설정 페이지의 "Instagram 앱 시크릿 코드" 표시 버튼.
# (예전 Facebook 로그인 방식의 FB_APP_ID/FB_APP_SECRET 과는 다른 값이니 주의)
IG_APP_SECRET=

# ── 텔레그램 승인 게이트 (notify/approve-poll 워크플로에서 사용) ──
# TG_BOT_TOKEN: @BotFather 와 대화해서 /newbot 으로 봇을 만들면 발급됨.
# TG_CHAT_ID: 만든 봇에게 아무 메시지나 먼저 보낸 뒤,
#   https://api.telegram.org/bot<TOKEN>/getUpdates 를 브라우저로 열어서
#   "message":{"chat":{"id": ...}} 에 있는 숫자를 그대로 쓰면 된다.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── 네이버 뉴스 검색 (화제 감지용) ──
# https://developers.naver.com/apps 에서 애플리케이션 등록 →
#   사용 API 에 '검색' 추가 → 클라이언트 ID/Secret 발급.
# 무료, 전체 검색 카테고리 합산 하루 25,000 회. 10분마다 12개 검색어를 돌려도
# 하루 1,700 회 수준이라 여유롭다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AI 헤드라인/캡션 초안 (뉴스카드, 선택) ──
# https://aistudio.google.com/apikey 에서 무료 발급. 없어도 동작은 한다 —
# 이 값이 없으면 news_watch.py 가 AI 초안을 건너뛰고, 사진 답장 캡션에
# 사람이 직접 헤드라인을 써야 하는 기존 방식으로 자동 대체된다.
GEMINI_API_KEY=
# 기본값 gemini-2.5-flash. 모델명이 바뀌면 여기만 바꾸면 된다.
GEMINI_MODEL=

# ── 미디어 호스팅 ──
# github | r2 | local
#   github: GitHub Release 를 공개 CDN 처럼 사용 (추가 비용 0) ← 기본
#   local : 발행 없이 렌더만 (개발용)
MEDIA_BACKEND=github
GH_TOKEN=
GITHUB_REPOSITORY=your-name/kbo-infographic-bot

# ── R2 로 전환할 때만 ──
# R2_BUCKET=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE=https://media.yourdomain.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

TZ=Asia/Seoul
