# 로컬 개발용. 실제 값은 절대 커밋하지 않는다.
# GitHub Actions 에서는 리포지토리 Settings → Secrets and variables → Actions 에 등록.

# ── Instagram (필수) ──
# IG_USER_ID: 인스타그램 비즈니스 계정의 IG User ID (FB 페이지 ID 와 다름)
#   확인: 그래프 API 탐색기 → GET /me/accounts → 페이지 선택
#         → GET /{page-id}?fields=instagram_business_account
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# ── 토큰 자동 갱신용 (권장) ──
FB_APP_ID=
FB_APP_SECRET=

# ── 미디어 호스팅 ──
# github | r2 | local
#   github: GitHub Release 를 공개 CDN 처럼 사용 (추가 비용 0) ← 기본
#   local : 발행 없이 렌더만 (개발용)
MEDIA_BACKEND=github
GH_TOKEN=
GITHUB_REPOSITORY=your-name/kbo-infographic-bot

# ── R2 로 전환할 때만 ──
# R2_BUCKET=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE=https://media.yourdomain.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

TZ=Asia/Seoul
