{# 유형 E — 뉴스형 카드.
   벤치마크 포맷: 전면 인물 사진 + 상단 후킹 문구(노란 괄호) + 하단 카테고리 배지
   + 2줄 헤드라인.

   다른 유형과 달리 헤드라인이 '하단'에 오기 때문에 base 의 frame_head/frame_foot
   을 비우고 이 템플릿이 직접 전체 배치를 잡는다. 브랜드 배지(우상단 원형)만
   base 그대로 유지해서 계정 일관성은 지킨다.

   사진은 반드시 사용자가 직접 넣은 것만 쓴다(assets/newsphotos/). 자동 수집 안 함 —
   헤드라인 감정선에 맞는 컷 선택은 사람이 해야 카드가 산다.
#}
{% extends "base.html.j2" %}

{% block card_class %}bleed newscard{% endblock %}

{% block extra_css %}
.photo{
  position:absolute; inset:0; z-index:0;
  background-image:url("{{ photo }}");
  background-size:cover;
  background-position:{{ photo_pos | default('center 22%') }};
  filter:saturate(1.08) contrast(1.06);
}
/* 상단은 후킹 문구가 읽히도록, 하단은 헤드라인 블록이 확실히 뜨도록 강하게 깐다 */
.veil{
  position:absolute; inset:0; z-index:1;
  background:
    linear-gradient(180deg,
      rgba(8,10,14,.78) 0%,
      rgba(8,10,14,.28) 18%,
      rgba(8,10,14,.10) 38%,
      rgba(8,10,14,.72) 62%,
      rgba(8,10,14,.97) 100%);
}

/* ── 상단 후킹 문구 ───────────────────────── */
.hook{
  position:absolute; z-index:4;
  top:38px; right:44px; max-width:78%;
  font-size:{{ hook_size | default(38) }}px; font-weight:800;
  color:{{ c.gold }};
  letter-spacing:-.02em; line-height:1.3;
  text-align:right; word-break:keep-all;
  text-shadow:0 4px 22px rgba(0,0,0,.75);
}

/* ── 하단 헤드라인 블록 ───────────────────── */
.news-wrap{
  position:absolute; z-index:4;
  left:0; right:0; bottom:0;
  padding:0 56px 62px;
  display:flex; flex-direction:column; align-items:flex-start;
}
.cat{
  display:inline-flex; align-items:center; gap:9px;
  font-size:25px; font-weight:800; letter-spacing:-.01em;
  color:#fff; background:{{ cat_color | default(c.accent_cool) }};
  padding:9px 20px; border-radius:9px;
  margin-bottom:26px;
  box-shadow:0 6px 20px rgba(0,0,0,.4);
}
.cat .dot{
  width:15px; height:15px; border-radius:50%;
  background:rgba(255,255,255,.9); flex:0 0 auto;
}
.line1{
  font-size:{{ line1_size }}px; font-weight:900; color:#fff;
  letter-spacing:-.035em; line-height:1.22; word-break:keep-all;
  text-shadow:0 6px 30px rgba(0,0,0,.6);
}
.line1 em{font-style:normal; color:{{ c.gold }}}
.rule{
  width:100%; height:2px; margin:20px 0;
  background:rgba(255,255,255,.22);
}
.line2{
  font-size:{{ line2_size }}px; font-weight:800; color:rgba(255,255,255,.94);
  letter-spacing:-.03em; line-height:1.28; word-break:keep-all;
  text-shadow:0 5px 24px rgba(0,0,0,.6);
}
.line2 em{font-style:normal; color:{{ c.gold }}}

/* 출처 — 하단 우측에 작게. 보도사진 사용 시 최소한의 크레딧 */
.credit{
  position:absolute; z-index:4; right:24px; bottom:14px;
  font-size:17px; font-weight:600; color:rgba(255,255,255,.42);
  letter-spacing:.01em;
}

{% if motion %}
.photo{animation:kenburns 8s ease-out both}
@keyframes kenburns{from{transform:scale(1.0)}to{transform:scale(1.08)}}
.hook{animation:fade .6s ease .2s both}
.cat{animation:slideUp .5s cubic-bezier(.16,1,.3,1) .35s both}
.line1{animation:slideUp .55s cubic-bezier(.16,1,.3,1) .5s both}
.rule{animation:fade .5s ease .75s both}
.line2{animation:slideUp .55s cubic-bezier(.16,1,.3,1) .8s both}
{% endif %}
{% endblock %}

{# 뉴스카드는 상단 타이틀/하단 푸터 프레임을 쓰지 않는다 #}
{% block frame_head %}{% endblock %}
{% block frame_foot %}{% endblock %}

{% block backdrop %}
  <div class="photo"></div>
  <div class="veil"></div>
  {% if hook %}<div class="hook">({{ hook }})</div>{% endif %}
{% endblock %}

{% block body %}
    <div class="news-wrap">
      {% if category %}
      <div class="cat"><span class="dot"></span>{{ category }}</div>
      {% endif %}
      <div class="line1">{{ line1 | safe }}</div>
      {% if line2 %}
        <div class="rule"></div>
        <div class="line2">{{ line2 | safe }}</div>
      {% endif %}
    </div>
    {% if photo_credit %}<div class="credit">사진 {{ photo_credit }}</div>{% endif %}
{% endblock %}
