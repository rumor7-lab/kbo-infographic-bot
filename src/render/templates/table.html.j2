{# 유형 A — 표 카드. 업로드 참고: '2027 FA 예상 명단', '후반기 성적' #}
{% extends "base.html.j2" %}

{% block extra_css %}
.tbl{width:100%; border-collapse:separate; border-spacing:0;
     background:var(--paper-pure); border-radius:var(--radius); overflow:hidden;
     box-shadow:0 2px 20px rgba(15,17,21,.07)}
.tbl thead th{
  background:var(--ink); color:#fff;
  font-size:{{ t.scale.table_head }}px; font-weight:800; letter-spacing:-.01em;
  padding:22px 16px; text-align:center; white-space:nowrap;
}
.tbl thead th:first-child{text-align:left; padding-left:28px}
.tbl tbody td{
  font-size:{{ t.scale.table_cell }}px; font-weight:700;
  padding:{{ cell_pad }}px 16px; text-align:center;
  border-bottom:1px solid var(--line); color:var(--ink);
}
.tbl tbody tr:last-child td{border-bottom:none}
.tbl tbody tr:nth-child(even) td{background:#FAFBFC}
.tbl td.label{text-align:left; padding-left:28px; white-space:nowrap}
.tbl td.rank{width:96px; font-weight:900; font-size:38px; color:var(--ink-soft)}
.tbl tr.top td.rank{color:var(--accent)}
.tbl td.up{color:var(--accent)}
.tbl td.down{color:var(--accent-cool)}

/* 팀 셀 — 로고 + 팀명 */
.team{display:flex; align-items:center; gap:14px}
.team img{width:{{ logo_size }}px; height:{{ logo_size }}px; object-fit:contain; flex:0 0 auto}
.team .swatch{width:8px; height:{{ logo_size }}px; border-radius:4px; background:var(--tc); flex:0 0 auto}
.team b{font-weight:800; letter-spacing:-.02em}

{% if motion %}
.tbl tbody tr{animation:rowIn .42s cubic-bezier(.16,1,.3,1) both}
{% for i in range(rows | length) %}
.tbl tbody tr:nth-child({{ i + 1 }}){animation-delay:{{ 0.3 + i * 0.075 }}s}
{% endfor %}
{% endif %}
{% endblock %}

{% block body %}
    <table class="tbl">
      <thead>
        <tr>
          {% for col in columns %}<th>{{ col }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="{{ 'top' if loop.first and rank_highlight else '' }}">
          {% for col in columns %}
            {% set v = row.get(col, '-') %}
            {% if col == label_col %}
              <td class="label">
                {% if row.get('_team') %}
                <div class="team" style="--tc:{{ teams.get(row['_team'], {}).get('primary', '#999') }}">
                  {% if logos_enabled and row.get('_logo') %}
                    <img src="{{ row['_logo'] }}" alt="">
                  {% else %}
                    <div class="swatch"></div>
                  {% endif %}
                  <b>{{ v }}</b>
                </div>
                {% else %}<b>{{ v }}</b>{% endif %}
              </td>
            {% elif col in ('순위', '순') %}
              <td class="rank">{{ v }}</td>
            {% else %}
              <td class="{{ diff_class(v) if col in diff_cols else '' }}">{{ v }}</td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
{% endblock %}
