{# 유형 B — 가로 바 차트. 업로드 참고: 'KBO 팀 승률 순위' (BRIEFLY 스타일) #}
{% extends "base.html.j2" %}

{% block extra_css %}
.bars{display:flex; flex-direction:column; gap:{{ bar_gap }}px; width:100%}
.bar-row{display:flex; align-items:center; gap:18px}
.bar-rank{
  flex:0 0 56px; font-size:36px; font-weight:900; color:rgba(255,255,255,.55);
  text-align:center;
}
.bar-row.top .bar-rank{color:var(--accent)}
.bar-logo{flex:0 0 {{ logo_size }}px; height:{{ logo_size }}px}
.bar-logo img{width:100%; height:100%; object-fit:contain}
.bar-track{flex:1 1 auto; min-width:0; position:relative; height:{{ bar_h }}px}
.bar-fill{
  height:100%; border-radius:{{ (bar_h / 2) | round | int }}px;
  background:var(--tc); display:flex; align-items:center;
  padding:0 22px; gap:16px; width:var(--bar-w);
  box-shadow:0 2px 10px rgba(15,17,21,.12);
  overflow:hidden;                 /* 막대 밖으로 텍스트가 새는 것을 원천 차단 */
  min-width:max-content;           /* 팀명 하나는 어떤 비율에서도 항상 다 보이게 최소폭 보장 */
}
.bar-name{
  color:#fff; font-size:33px; font-weight:800; letter-spacing:-.02em;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
/* 승무패 기록은 막대 폭에 따라 길이가 들쭉날쭉해 하위 팀에서 잘리므로
   막대 밖(팀명 아래)에 고정폭 캡션으로 별도 표기한다 */
.bar-rec{
  color:rgba(255,255,255,.55); font-size:24px; font-weight:700;
  white-space:nowrap; margin-top:6px;
}
.bar-main{display:flex; flex-direction:column; justify-content:center; flex:1 1 auto; min-width:0}
.bar-val{
  flex:0 0 auto; font-size:40px; font-weight:900; letter-spacing:-.03em;
  min-width:150px; text-align:right;
}
.bar-row.top .bar-val{color:var(--accent)}

{% if motion %}
.bar-fill{animation:growBar .78s cubic-bezier(.16,1,.3,1) both}
.bar-row{animation:rowIn .4s ease both}
{% for i in range(rows | length) %}
.bar-row:nth-child({{ i + 1 }}){animation-delay:{{ 0.28 + i * 0.06 }}s}
.bar-row:nth-child({{ i + 1 }}) .bar-fill{animation-delay:{{ 0.34 + i * 0.06 }}s}
{% endfor %}
{% endif %}
{% endblock %}

{% block body %}
    <div class="bars">
      {% for row in rows %}
      {% set tc = teams.get(row.get('_team', ''), {}).get('primary', c.ink) %}
      <div class="bar-row {{ 'top' if loop.first else '' }}"
           style="--tc:{{ tc }}; --bar-w:{{ row['_bar_pct'] }}%">
        <div class="bar-rank">{{ loop.index }}</div>
        {% if logos_enabled and row.get('_logo') %}
        <div class="bar-logo"><img src="{{ row['_logo'] }}" alt=""></div>
        {% endif %}
        <div class="bar-main">
          <div class="bar-track">
            <div class="bar-fill">
              <span class="bar-name">{{ row[label_col] }}</span>
            </div>
          </div>
          {% if row.get('_sub') %}<span class="bar-rec">{{ row['_sub'] }}</span>{% endif %}
        </div>
        <div class="bar-val">{{ row[metric] }}</div>
      </div>
      {% endfor %}
    </div>
{% endblock %}
